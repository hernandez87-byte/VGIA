NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Opcional. Si queda vacío, VIGÍA usa OpenStreetMap como mapa base local.
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_DEFAULT_LATITUDE=25.6866
NEXT_PUBLIC_DEFAULT_LONGITUDE=-100.3161

# Conector opcional de Facebook Pages, solo para dependencias oficiales.
# Requiere una app de Meta aprobada y Page Public Content Access.
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v24.0
META_PCNL_PAGE_ID=
META_MONTERREY_SEGURIDAD_PAGE_ID=

# Los videos de TikTok se registran desde /operador y se enriquecen con oEmbed.
# Para sincronizar automáticamente videos recientes de una cuenta se necesita
# TikTok Login Kit, Display API, scope video.list y autorización de esa cuenta.

# Solo para procesos de servidor controlados. Nunca uses NEXT_PUBLIC_ para secretos.
SUPABASE_SECRET_KEY=
OFFICIAL_ALERTS_SIGNING_KEY=
