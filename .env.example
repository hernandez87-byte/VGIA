NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Opcional. Si queda vacío, VIGÍA usa OpenStreetMap como mapa base local.
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_DEFAULT_LATITUDE=25.6866
NEXT_PUBLIC_DEFAULT_LONGITUDE=-100.3161

# Conector opcional de Facebook Pages. Son variables exclusivas del servidor.
# Requiere una app de Meta aprobada y Page Public Content Access.
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v24.0
META_PCNl_PAGE_ID=
META_TELEDIARIO_PAGE_ID=
META_INFO7_PAGE_ID=
META_ABC_PAGE_ID=

# Solo para procesos de servidor controlados. Nunca uses NEXT_PUBLIC_ para secretos.
SUPABASE_SECRET_KEY=
OFFICIAL_ALERTS_SIGNING_KEY=
